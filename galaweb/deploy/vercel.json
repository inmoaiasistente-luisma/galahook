    { "source": "/api/admin-booking-document-confirm", "destination": "/api/admin-router?action=booking-document-confirm" },
    { "source": "/api/admin-booking-document-download-url", "destination": "/api/admin-router?action=booking-document-download-url" },
    { "source": "/api/admin-booking-communication-send", "destination": "/api/admin-router?action=booking-communication-send" },
    { "source": "/api/admin-booking-communication-detail", "destination": "/api/admin-router?action=booking-communication-detail" },
    { "source": "/api/admin-reminders-run", "destination": "/api/admin-router?action=reminders-run" },
    { "source": "/api/admin-reminders-toggle", "destination": "/api/admin-router?action=reminders-toggle" },
    { "source": "/api/admin-discount-rules", "destination": "/api/admin-router?action=discount-rules-list" },
    { "source": "/api/admin-discount-rule-save", "destination": "/api/admin-router?action=discount-rule-save" },
    { "source": "/api/admin-discount-rule-toggle", "destination": "/api/admin-router?action=discount-rule-toggle" },
    { "source": "/api/admin-test-data-list", "destination": "/api/admin-router?action=test-data-list" },
    { "source": "/api/admin-test-data-mark", "destination": "/api/admin-router?action=test-data-mark" },
    { "source": "/api/admin-test-data-archive", "destination": "/api/admin-router?action=test-data-archive" },
    { "source": "/api/admin-notifications", "destination": "/api/admin-router?action=notifications-list" },
    { "source": "/api/admin-notifications-retry", "destination": "/api/admin-router?action=email-retry" },
    { "source": "/api/admin-notifications-retry-batch", "destination": "/api/admin-router?action=notifications-retry-batch" },
    { "source": "/api/admin-tour-notes", "destination": "/api/admin-router?action=tour-notes-list" },
    { "source": "/api/admin-tour-notes-save", "destination": "/api/admin-router?action=tour-notes-save" },
    { "source": "/api/admin-passenger-intakes", "destination": "/api/admin-router?action=passenger-intakes-list" },
    { "source": "/api/admin-passenger-intake-detail", "destination": "/api/admin-router?action=passenger-intake-detail" },
    { "source": "/api/admin-passenger-intake-review", "destination": "/api/admin-router?action=passenger-intake-review" },
    { "source": "/api/admin-passenger-intake-request-changes", "destination": "/api/admin-router?action=passenger-intake-request-changes" },
    { "source": "/api/admin-passenger-intake-renew", "destination": "/api/admin-router?action=passenger-intake-renew" },
    { "source": "/api/admin-passenger-document-reveal", "destination": "/api/admin-router?action=passenger-document-reveal" },
    { "source": "/api/admin-lodging-save", "destination": "/api/admin-router?action=lodging-requirements-save" },
    { "source": "/api/admin-hotel-preferences", "destination": "/api/admin-router?action=hotel-preferences-list" },
    { "source": "/api/admin-hotel-preferences-save", "destination": "/api/admin-router?action=hotel-preferences-save" },
    { "source": "/api/admin-package-prices-list", "destination": "/api/admin-router?action=package-prices-list" },
    { "source": "/api/admin-package-price-draft-save", "destination": "/api/admin-router?action=package-price-draft-save" },
    { "source": "/api/admin-package-price-publish", "destination": "/api/admin-router?action=package-price-publish" },
    { "source": "/api/admin-package-price-history", "destination": "/api/admin-router?action=package-price-history" },
    { "source": "/api/admin-package-price-rollback", "destination": "/api/admin-router?action=package-price-rollback" },
    { "source": "/api/admin-package-price-toggle", "destination": "/api/admin-router?action=package-price-toggle" },
    { "source": "/api/admin-package-price-update", "destination": "/api/admin-router?action=package-price-update" },
    { "source": "/api/admin-milu-search-start", "destination": "/api/admin-router?action=milu-search-start" },
    { "source": "/api/admin-milu-search-status", "destination": "/api/admin-router?action=milu-search-status" },
    { "source": "/api/admin-milu-search-cancel", "destination": "/api/admin-router?action=milu-search-cancel" },
    { "source": "/api/admin-milu-options-list", "destination": "/api/admin-router?action=milu-options-list" },
    { "source": "/api/admin-milu-settings", "destination": "/api/admin-router?action=milu-settings-get" },
    { "source": "/api/admin-milu-settings-save", "destination": "/api/admin-router?action=milu-settings-save" },
    { "source": "/api/admin-milu-research-rerun", "destination": "/api/admin-router?action=milu-research-rerun" },
    { "source": "/api/admin-milu-research-approve", "destination": "/api/admin-router?action=milu-research-approve" },
    { "source": "/api/admin-milu-itinerary-preview", "destination": "/api/admin-router?action=milu-itinerary-preview" }
  ],
  "crons": [
    { "path": "/api/admin-reminders-run", "schedule": "0 13 * * *" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
    { "source": "/(.*)\\.html", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
      { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(self \"https://js.stripe.com\")" }
    ] },
    { "source": "/admin.html", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" }
    ] }
  ]
}
