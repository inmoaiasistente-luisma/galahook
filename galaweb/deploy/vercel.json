    { "source": "/api/admin-booking-finance", "destination": "/api/admin-router?action=booking-finance" },
    { "source": "/api/admin-booking-cost-line-add", "destination": "/api/admin-router?action=booking-cost-line-add" },
    { "source": "/api/admin-booking-cost-line-delete", "destination": "/api/admin-router?action=booking-cost-line-delete" },
    { "source": "/api/admin-booking-costs-confirm", "destination": "/api/admin-router?action=booking-costs-confirm" },
    { "source": "/api/admin-booking-comms", "destination": "/api/admin-router?action=booking-comms" },
    { "source": "/api/admin-booking-document-save", "destination": "/api/admin-router?action=booking-document-save" },
