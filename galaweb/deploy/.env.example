# =====================================================================
# LOAN-IX Booking Engine — plantilla de variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local ni secretos reales al repositorio.
# =====================================================================

# ── Stripe (TEST durante el desarrollo; se cambia a LIVE en el lanzamiento) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# La clave publicable es pública y vivirá en assets/js/payments-config.js (frontend), no aquí.

# ── Supabase (solo servidor — NUNCA exponer la secret key en el navegador) ──
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Panel admin (Paso 5) ──
ADMIN_PASSWORD_HASH=xxx        # hash, nunca la contraseña en claro
SESSION_SECRET=xxx             # cadena aleatoria larga

# ── Motor de reservas ──
TENANT_ID=hook-adventure
