# =====================================================================
# LOAN-IX Booking Engine — plantilla de variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local ni secretos reales al repositorio.
# =====================================================================

# ── Stripe (TEST durante el desarrollo; se cambia a LIVE en el lanzamiento) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Clave publicable (pública). La sirve /api/stripe-config al frontend; no se expone la secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Supabase ──
SUPABASE_URL=https://xxxxx.supabase.co
# Clave publicable: la usa el servidor para signInWithPassword (login del panel admin).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clave secreta: SOLO servidor — NUNCA exponer en el navegador.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Panel admin (solo servidor) ──
# Los usuarios y sus contraseñas viven en Supabase Auth; la autorización
# (tenant, rol, activo) en public.admin_profiles. Ver docs/admin-auth.md.
# Genera el secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=long_random_secret_xxx
# LEGACY: ADMIN_PASSWORD_HASH ya NO se usa (el login es Supabase Auth). Si todavía
# existe en el proyecto de Vercel, elimínala manualmente. No la agregues aquí.

# ── Correo transaccional (Resend) — solo servidor ──
RESEND_API_KEY=re_xxx
# Remitente VERIFICADO en Resend (dominio con SPF/DKIM configurados)
EMAIL_FROM=Hook Adventure <reservations@galapagoshookadventure.com>
EMAIL_REPLY_TO=info@galapagoshookadventure.com
# Buzón interno que recibe reservas, cotizaciones y ventas directas
BOOKING_NOTIFICATION_EMAIL=reservas@galapagoshookadventure.com

# ── URL pública ──
# Preview: la URL del deployment de preview. Production: el dominio real.
# Los QR y el logo de los correos se construyen con esta URL, así que en
# Production debe ser el dominio canónico (no una URL de Preview).
PUBLIC_SITE_URL=https://www.galapagoshookadventure.com

# ── Firma de los códigos QR (solo servidor) ──
# DISTINTO de SESSION_SECRET. Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=long_random_qr_secret_xxx

# ── Motor de reservas ──
TENANT_ID=hook-adventure
