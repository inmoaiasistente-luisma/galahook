# =====================================================================
# LOAN-IX Booking Engine — plantilla de variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local ni secretos reales al repositorio.
# =====================================================================

# ── Stripe (TEST durante el desarrollo; se cambia a LIVE en el lanzamiento) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Clave publicable (pública). La sirve /api/stripe-config al frontend; no se expone la secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Supabase ──
SUPABASE_URL=https://xxxxx.supabase.co
# Clave publicable: la usa el servidor para signInWithPassword (login del panel admin).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clave secreta: SOLO servidor — NUNCA exponer en el navegador.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Panel admin (solo servidor) ──
# Los usuarios y sus contraseñas viven en Supabase Auth; la autorización
# (tenant, rol, activo) en public.admin_profiles. Ver docs/admin-auth.md.
# Genera el secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=long_random_secret_xxx
# LEGACY: ADMIN_PASSWORD_HASH ya NO se usa (el login es Supabase Auth). Si todavía
# existe en el proyecto de Vercel, elimínala manualmente. No la agregues aquí.

# ── Correo transaccional (Resend) — solo servidor ──
RESEND_API_KEY=re_xxx
# Remitente VERIFICADO en Resend (dominio con SPF/DKIM configurados)
EMAIL_FROM=Hook Adventure <reservations@galapagoshookadventure.com>
EMAIL_REPLY_TO=info@galapagoshookadventure.com
# Buzón interno que recibe reservas, cotizaciones y ventas directas
BOOKING_NOTIFICATION_EMAIL=reservas@galapagoshookadventure.com

# ── URL pública ──
# Preview: la URL del deployment de preview. Production: el dominio real.
# Los QR y el logo de los correos se construyen con esta URL, así que en
# Production debe ser el dominio canónico (no una URL de Preview).
PUBLIC_SITE_URL=https://www.galapagoshookadventure.com

# ── Firma de los códigos QR (solo servidor) ──
# DISTINTO de SESSION_SECRET. Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=long_random_qr_secret_xxx

# ── Motor de reservas ──
TENANT_ID=hook-adventure

# =====================================================================
# ── Etapa 8 — intake de pasajeros y datos de documentos ──
# =====================================================================

# Firma del token del formulario de pasajeros (solo servidor).
# DISTINTO de SESSION_SECRET y de QR_SIGNING_SECRET. Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSENGER_FORM_SECRET=long_random_passenger_form_secret_xxx

# Cifrado del número de documento (AES-256-GCM) — keyring por id de clave.
# El id de la clave ACTIVA con la que se cifra siempre lo nuevo:
PASSENGER_DATA_ENCRYPTION_ACTIVE_KEY_ID=k1
# Mapa key_id -> clave base64 de 32 BYTES. Puede tener varias (para rotación).
# Genera una clave con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Formato (una sola línea, JSON): {"k1":"<base64-32B>","k2":"<base64-32B>"}
PASSENGER_DATA_ENCRYPTION_KEYS_JSON={"k1":"REEMPLAZA_POR_BASE64_DE_32_BYTES"}

# =====================================================================
# ── Etapa 8C — Milu Turismo (búsqueda de vuelos/hoteles) ──
# =====================================================================
# Feature flags SERVER-ONLY. Durante 8C todas en false: el módulo no se
# activa públicamente ni ejecuta proveedores reales. Nunca se confía en
# flags enviados por el navegador.
MILU_TOURISM_ENABLED=false
MILU_TOURISM_WORKER_ENABLED=false
MILU_TOURISM_DUFFEL_ENABLED=false
MILU_TOURISM_HOTEL_PROVIDER_ENABLED=false
MILU_TOURISM_SONNET_ENABLED=false
# Web Research (8D): mitad ENV de la COMPUERTA DOBLE. Para que Milu ejecute
# búsquedas web se requiere ESTA variable = true Y milu_settings.web_research_enabled
# = true (ambas false por defecto). El worker necesita además ANTHROPIC_API_KEY.
MILU_TOURISM_WEB_RESEARCH_ENABLED=false

# Modelo de IA de Milu (v1: Haiku-only). Configura el IDENTIFICADOR EXACTO de
# Haiku aceptado por la API oficial de Anthropic; se valida contra una allowlist
# server-side (solo Haiku permitido en v1). Si falta o no está permitido, las
# subtareas de IA quedan en configuration_error (NUNCA se cambia a otro modelo).
ANTHROPIC_MILU_TOURISM_MODEL=claude-haiku-4-5

# ── Secretos del worker (Supabase Edge Function) — NO se crean en 8C ──
# Se configuran más adelante (8D+) en los Edge Function secrets de Supabase,
# NO en Vercel. Aquí solo se documentan los NOMBRES (sin valores):
#   ANTHROPIC_API_KEY=<clave Anthropic para el worker>
#   DUFFEL_ACCESS_TOKEN=<token Duffel sandbox/live>
#   MILU_HOTEL_PROVIDER_API_KEY=<clave del proveedor hotelero>
#   MILU_HOTEL_PROVIDER_API_SECRET=<secreto del proveedor hotelero>

# ── Fase 9: recordatorios automáticos pre-viaje ──
# El cron de Vercel (vercel.json → "crons") llama cada día a
# /api/admin-reminders-run con la cabecera Authorization: Bearer <CRON_SECRET>.
# SIN esta variable la vía del cron NO existe: el endpoint solo aceptará una
# sesión de owner. Genera un valor largo y aleatorio (32+ bytes).
# IMPORTANTE: los crons de Vercel se ejecutan SOLO en Production. En Preview
# el owner puede lanzar el barrido a mano desde el panel.
CRON_SECRET=
